# Expo public environment variables
# Prefix with EXPO_PUBLIC_ to expose in app code.
# Android emulator requests to localhost are normalized to 10.0.2.2 in lib/api/client.ts.

EXPO_PUBLIC_API_BASE_URL=https://qurve.duckdns.org
EXPO_PUBLIC_APP_ENV=development
# Optional: fixes the web OAuth callback origin. If omitted, the current browser origin is used.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:8081
